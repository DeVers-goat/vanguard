<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Library</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Oxanium:wght@700;800&display=swap" />
  <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body, #root { height: 100%; }

    :root {
      --canvas: #08080f;
      --g0: rgba(255,255,255,.028); --g1: rgba(255,255,255,.052);
      --g2: rgba(255,255,255,.085); --e0: rgba(255,255,255,.055);
      --t0: #1a1a30; --t1: #3a3a5a; --t2: #6868a0; --t3: #9898c8; --t4: #c4c4e0; --t5: #e8e8f8; --t6: #f5f5ff;
      --p: #7c6ef8; --p1: rgba(124,110,248,.16); --p2: rgba(124,110,248,.08);
      --em: #2dd4a0; --em1: rgba(45,212,160,.14); --em2: rgba(45,212,160,.06);
      --am: #f5a623; --am1: rgba(245,166,35,.14);
      --ro: #f06292; --ro1: rgba(240,98,146,.14);
      --sk: #38b2f8; --sk1: rgba(56,178,248,.14);
      --or: #f97136; --or1: rgba(249,113,54,.14);
      --gold: #e4b84a; --gold1: rgba(228,184,74,.14);
      --surface: #0f0f1a; --surface2: #14142a; --surface3: #1a1a2e;
      --border: rgba(255,255,255,.07); --border-p: rgba(124,110,248,.22);
      --fd: 'Oxanium', sans-serif; --fm: 'JetBrains Mono', monospace; --fb: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      background: var(--canvas);
      color: var(--t4);
      font-family: var(--fb);
      overflow-x: hidden;
      min-height: 100vh;
    }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(124,110,248,.25); border-radius: 4px; }

    input, button, textarea, select { font-family: inherit; outline: none; border: none; background: none; }
    textarea { resize: none; }

    /* ── BACKGROUND ── */
    body::before {
      content: '';
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background-image:
        linear-gradient(rgba(124,110,248,.022) 1px, transparent 1px),
        linear-gradient(90deg, rgba(124,110,248,.022) 1px, transparent 1px);
      background-size: 48px 48px;
      animation: gridPan 80s linear infinite;
    }
    body::after {
      content: '';
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background:
        radial-gradient(ellipse 65% 50% at 10% 5%, rgba(124,110,248,.09) 0%, transparent 65%),
        radial-gradient(ellipse 45% 40% at 88% 92%, rgba(45,212,160,.05) 0%, transparent 60%),
        radial-gradient(ellipse 30% 30% at 72% 8%, rgba(56,178,248,.04) 0%, transparent 55%);
    }
    #root { position: relative; z-index: 1; }

    /* ── ANIMATIONS ── */
    @keyframes gridPan     { 0% { background-position: 0 0; } 100% { background-position: 48px 48px; } }
    @keyframes fadeUp      { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes fadeIn      { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slideUp     { from { opacity: 0; transform: translateY(44px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @keyframes textReveal  { from { opacity: 0; filter: blur(6px); transform: translateY(8px); } to { opacity: 1; filter: blur(0); transform: translateY(0); } }
    @keyframes staggerFade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes spin        { to { transform: rotate(360deg); } }
    @keyframes bouncePop   { 0% { transform: scale(.3); opacity: 0; } 55% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }
    @keyframes float       { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
    @keyframes glowPulse   { 0%, 100% { box-shadow: 0 0 0 1px rgba(124,110,248,.18), 0 4px 28px rgba(0,0,0,.5); } 50% { box-shadow: 0 0 0 1px rgba(124,110,248,.4), 0 4px 36px rgba(124,110,248,.22); } }
    @keyframes coverReveal { from { opacity: 0; transform: scale(.92) translateY(20px); filter: blur(8px); } to { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); } }
    @keyframes sectionIn   { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
    @keyframes badgeIn     { from { opacity: 0; transform: scale(.4); } 60% { transform: scale(1.15); } to { opacity: 1; transform: scale(1); } }

    /* ── UTILITY CLASSES ── */
    .au           { animation: fadeUp .4s cubic-bezier(.22,1,.36,1) both; }
    .text-reveal  { animation: textReveal .6s cubic-bezier(.22,1,.36,1) both; }
    .float        { animation: float 3.4s ease-in-out infinite; }

    .stagger > *                { animation: staggerFade .5s cubic-bezier(.22,1,.36,1) both; }
    .stagger > *:nth-child(1)   { animation-delay: .04s; }
    .stagger > *:nth-child(2)   { animation-delay: .09s; }
    .stagger > *:nth-child(3)   { animation-delay: .14s; }
    .stagger > *:nth-child(4)   { animation-delay: .19s; }
    .stagger > *:nth-child(5)   { animation-delay: .24s; }
    .stagger > *:nth-child(6)   { animation-delay: .29s; }
    .stagger > *:nth-child(7)   { animation-delay: .34s; }
    .stagger > *:nth-child(8)   { animation-delay: .39s; }
    .stagger > *:nth-child(n+9) { animation-delay: .44s; }

    /* ── BUTTONS ── */
    button {
      cursor: pointer;
      transition: transform .2s cubic-bezier(.34,1.56,.64,1), box-shadow .22s ease, filter .22s ease, background .22s ease;
    }
    button:hover  { filter: brightness(1.08); }
    button:active { transform: scale(.96); transition: transform .1s ease-out; }

    .btn-shine { position: relative; overflow: hidden; isolation: isolate; }
    .btn-shine::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(115deg, transparent 40%, rgba(255,255,255,.22) 50%, transparent 60%);
      transform: translateX(-120%);
      transition: transform .7s cubic-bezier(.22,1,.36,1);
      pointer-events: none;
    }
    .btn-shine:hover::before { transform: translateX(120%); }

    .btn-lift:hover  { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(109,95,245,.4), 0 2px 0 rgba(255,255,255,.08) inset; }
    .btn-lift:active { transform: translateY(0) scale(.97); }

    /* ── CARDS ── */
    .card-tilt { transition: transform .35s cubic-bezier(.22,1,.36,1), box-shadow .35s ease; }
    .card-tilt:hover {
      transform: translateY(-5px) scale(1.018);
      box-shadow: 0 18px 44px rgba(0,0,0,.6), 0 0 0 1px rgba(124,110,248,.2);
    }

    /* ── INPUTS ── */
    input:focus, textarea:focus {
      border-color: rgba(124,110,248,.5) !important;
      box-shadow: 0 0 0 3px rgba(124,110,248,.1) !important;
      transition: border-color .2s ease, box-shadow .2s ease;
    }

    /* ── ANALYSIS ── */
    .section-in { animation: sectionIn .5s cubic-bezier(.22,1,.36,1) both; }
    .section-in:nth-child(1) { animation-delay: .06s; }
    .section-in:nth-child(2) { animation-delay: .16s; }
    .section-in:nth-child(3) { animation-delay: .26s; }
    .section-in:nth-child(4) { animation-delay: .36s; }

    /* ── MISC ── */
    .suggestion-item:hover { background: rgba(124,110,248,.07) !important; }
    .chapter-btn:hover     { background: rgba(124,110,248,.06) !important; }
    .tab-btn               { flex: 1; padding: 8px; border-radius: 7px; font-size: 13px; font-weight: 600; transition: background .15s, color .15s; cursor: pointer; border: none; }
    .cover-enter           { animation: coverReveal .55s cubic-bezier(.22,1,.36,1) both; }
    .badge-pop             { animation: badgeIn .4s cubic-bezier(.34,1.56,.64,1) both; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    const { useState, useEffect, useRef, useCallback } = React;

    // ── TOKENS ──────────────────────────────────────────────────────────────────
    const C = {
      canvas:'#08080f', surface:'#0f0f1a', surface2:'#14142a', surface3:'#1a1a2e',
      border:'rgba(255,255,255,.07)', borderP:'rgba(124,110,248,.22)',
      p:'#7c6ef8', p1:'rgba(124,110,248,.16)', p2:'rgba(124,110,248,.08)',
      em:'#2dd4a0', em1:'rgba(45,212,160,.14)',
      gold:'#e4b84a', gold1:'rgba(228,184,74,.14)',
      sk:'#38b2f8', sk1:'rgba(56,178,248,.14)',
      ro:'#f06292', ro1:'rgba(240,98,146,.14)',
      am:'#f5a623', am1:'rgba(245,166,35,.14)',
      t2:'#6868a0', t3:'#9898c8', t4:'#c4c4e0', t5:'#e8e8f8', t6:'#f5f5ff',
      error:'#f06292',
    };

    function debounce(fn, ms) {
      let t;
      return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
    }

    // ── AI CALL (Gemini) ─────────────────────────────────────────────────────────
    async function callAI(apiKey, title, authors, description) {
      const prompt = `You are an expert book analyst creating a permanent reference summary for someone who wants to deeply understand and revisit "${title}" by ${authors} at any time.${description ? `\n\nPublisher description: ${description}` : ''}

Return ONLY a valid JSON object with no extra text, no markdown, no code fences:
{
  "summary": "A rich 3-4 paragraph overview covering the book's central thesis, why it was written, the core framework or argument, and its lasting significance.",
  "goldenTips": ["A fully explained tip — not just a label but a complete insight with context and why it matters", "tip 2", "tip 3", "tip 4", "tip 5", "tip 6", "tip 7"],
  "realLife": ["A concrete, specific action someone can apply today — describe the situation, what to do, and the expected outcome", "takeaway 2", "takeaway 3", "takeaway 4", "takeaway 5", "takeaway 6"],
  "chapters": [
    {
      "title": "Chapter 1: Full Chapter Title",
      "summary": "A thorough 4-6 paragraph summary of this chapter. Cover: the main argument or story of the chapter, the key concepts and how they are explained, any examples, anecdotes or case studies the author uses, the most important insights and why they matter, and how this chapter connects to the book's overall message. Write it so someone who reads only this summary fully understands what the chapter teaches."
    }
  ]
}

Rules:
- Every chapter summary must be 4-6 substantial paragraphs — never a single sentence or short paragraph.
- List every chapter in the correct order with accurate titles.
- Golden tips must be complete thoughts, not labels (e.g. not just "Be proactive" but a full explanation of what that means and why).
- Real life takeaways must be specific and actionable with a clear outcome described.
- Write as if this reference will be read years from now by someone who has forgotten the book.`;

      const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ role: 'user', parts: [{ text: prompt }] }],
          generationConfig: { maxOutputTokens: 8192, temperature: 0.7 },
        }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error?.message || `API error ${res.status}`);
      }

      const data = await res.json();
      let text = (data.candidates[0].content.parts[0].text || '').trim();
      text = text.replace(/^```(?:json)?\s*/i, '').replace(/\s*```$/, '');
      try {
        return JSON.parse(text);
      } catch {
        const summaryMatch = text.match(/"summary"\s*:\s*"([\s\S]*?)"\s*,\s*"goldenTips"/);
        const tipsMatch    = text.match(/"goldenTips"\s*:\s*(\[[\s\S]*?\])\s*,\s*"realLife"/);
        const realMatch    = text.match(/"realLife"\s*:\s*(\[[\s\S]*?\])\s*,\s*"chapters"/);
        const chaptersStart = text.indexOf('"chapters"');
        if (chaptersStart === -1) throw new Error('AI returned malformed JSON — please try again');
        let chaptersStr = text.slice(chaptersStart + '"chapters"'.length).replace(/^\s*:\s*/, '');
        const lastClose = chaptersStr.lastIndexOf('}');
        if (lastClose !== -1) chaptersStr = chaptersStr.slice(0, lastClose + 1) + ']';
        let chapters = [];
        try { chapters = JSON.parse(chaptersStr); } catch {}
        return {
          summary: summaryMatch ? summaryMatch[1].replace(/\\n/g, '\n') : '',
          goldenTips: tipsMatch ? JSON.parse(tipsMatch[1]) : [],
          realLife: realMatch ? JSON.parse(realMatch[1]) : [],
          chapters,
        };
      }
    }

    // ── SETTINGS MODAL ───────────────────────────────────────────────────────────
    function SettingsModal({ apiKey, onSave, onClose }) {
      const [val, setVal] = useState(apiKey || '');
      const save = () => { onSave(val.trim()); onClose(); };
      return (
        <div
          onClick={onClose}
          style={{position:'fixed',inset:0,background:'rgba(0,0,0,.72)',backdropFilter:'blur(8px)',display:'flex',alignItems:'center',justifyContent:'center',zIndex:300}}
        >
          <div
            onClick={e=>e.stopPropagation()}
            style={{
              background:C.surface, border:`1px solid ${C.borderP}`,
              borderRadius:20, padding:36, width:480, maxWidth:'92vw',
              boxShadow:'0 32px 80px rgba(0,0,0,.6), 0 0 0 1px rgba(124,110,248,.12)',
              animation:'slideUp .35s cubic-bezier(.22,1,.36,1) both',
            }}
          >
            <div style={{display:'flex',alignItems:'center',gap:12,marginBottom:6}}>
              <div style={{width:36,height:36,borderRadius:10,background:C.p1,border:`1px solid ${C.borderP}`,display:'flex',alignItems:'center',justifyContent:'center',color:C.p}}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </div>
              <h2 style={{fontSize:18,fontWeight:800,fontFamily:'var(--fd)',color:C.t6}}>API Settings</h2>
            </div>
            <p style={{color:C.t3,fontSize:13,marginBottom:28,lineHeight:1.65,paddingLeft:48}}>
              Paste your Gemini key to enable AI book analysis. Free tier — no credit card needed.
            </p>

            <label style={{fontSize:11,color:C.t2,display:'block',marginBottom:8,textTransform:'uppercase',letterSpacing:1.1,fontFamily:'var(--fm)'}}>Gemini API Key</label>
            <input
              type="password" value={val} onChange={e=>setVal(e.target.value)}
              onKeyDown={e=>e.key==='Enter'&&save()}
              placeholder="AIza..."
              autoFocus
              style={{
                width:'100%', background:C.surface2,
                border:`1px solid ${C.border}`, borderRadius:10,
                padding:'13px 15px', color:C.t6, fontSize:14,
              }}
            />
            <p style={{fontSize:12,color:C.t2,marginTop:8,lineHeight:1.5}}>
              Get a free key at{' '}
              <span style={{color:C.p,fontWeight:600}}>aistudio.google.com</span>
            </p>

            <div style={{display:'flex',gap:10,marginTop:28}}>
              <button
                onClick={save}
                className="btn-shine btn-lift"
                style={{flex:1,padding:'13px',background:C.p,border:'none',borderRadius:10,color:'#fff',fontWeight:700,fontSize:14,letterSpacing:.3}}
              >
                Save Key
              </button>
              <button
                onClick={onClose}
                style={{padding:'13px 22px',background:'transparent',border:`1px solid ${C.border}`,borderRadius:10,color:C.t3,fontSize:14}}
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      );
    }

    // ── BOOK CARD (selected detail view) ─────────────────────────────────────────
    function BookCard({ book }) {
      const v = book.volumeInfo;
      const cover = v.imageLinks?.thumbnail?.replace('http:', 'https:') || v.imageLinks?.smallThumbnail?.replace('http:', 'https:');
      return (
        <div className="cover-enter" style={{
          display:'flex', gap:24, padding:26,
          background:C.surface, border:`1px solid ${C.border}`,
          borderRadius:18, position:'relative', overflow:'hidden',
        }}>
          <div style={{position:'absolute',top:0,left:'8%',right:'8%',height:1,background:`linear-gradient(to right,transparent,${C.p} 40%,transparent)`,opacity:.3}} />
          {cover
            ? <img src={cover} alt={v.title} className="cover-enter" style={{width:90,height:134,objectFit:'cover',borderRadius:8,flexShrink:0,boxShadow:`0 8px 28px rgba(0,0,0,.6), 0 0 0 1px ${C.border}`}} />
            : <div style={{width:90,height:134,background:C.surface2,borderRadius:8,display:'flex',alignItems:'center',justifyContent:'center',color:C.t2,fontSize:11,flexShrink:0,border:`1px solid ${C.border}`}}>No Cover</div>
          }
          <div style={{flex:1,minWidth:0,paddingTop:4}}>
            <h2 className="text-reveal" style={{fontSize:20,fontWeight:800,lineHeight:1.3,marginBottom:5,color:C.t6,fontFamily:'var(--fd)'}}>{v.title}</h2>
            {v.subtitle && <p style={{color:C.t3,fontSize:13,marginBottom:10,lineHeight:1.45}}>{v.subtitle}</p>}
            <p style={{color:C.p,fontSize:13,fontWeight:700,marginBottom:14}}>{(v.authors||['Unknown Author']).join(', ')}</p>
            <div style={{display:'flex',gap:7,flexWrap:'wrap'}}>
              {v.pageCount      && <MetaTag>{v.pageCount} pages</MetaTag>}
              {v.publishedDate  && <MetaTag>{v.publishedDate.slice(0,4)}</MetaTag>}
              {v.categories?.[0] && <MetaTag accent>{v.categories[0]}</MetaTag>}
            </div>
          </div>
        </div>
      );
    }

    function MetaTag({ children, accent }) {
      return (
        <span style={{
          fontSize:11, fontFamily:'var(--fm)',
          color: accent ? C.p : C.t2,
          background: accent ? C.p2 : C.surface2,
          border:`1px solid ${accent ? C.borderP : C.border}`,
          padding:'3px 9px', borderRadius:20,
        }}>
          {children}
        </span>
      );
    }

    // ── BOOK COVER TILE ───────────────────────────────────────────────────────────
    function BookCoverTile({ book, onSelect, onRemove, onEdit }) {
      const v = book.volumeInfo;
      const cover = v.imageLinks?.thumbnail?.replace('http:', 'https:');
      const authorStr = (v.authors || []).join(', ');
      const hues = [240, 260, 280, 300, 200, 220, 320, 190];
      const hue  = hues[(v.title.charCodeAt(0) || 0) % hues.length];

      return (
        <div
          className="card-tilt"
          onClick={() => onSelect(book)}
          style={{position:'relative',width:'100%',paddingTop:'150%',borderRadius:12,overflow:'hidden',cursor:'pointer',boxShadow:'0 6px 24px rgba(0,0,0,.5)'}}
        >
          <div style={{position:'absolute',inset:0}}>
            {cover
              ? <img src={cover} alt={v.title} style={{width:'100%',height:'100%',objectFit:'cover'}} />
              : <div style={{
                  width:'100%',height:'100%',
                  background:`linear-gradient(145deg, hsl(${hue},38%,12%) 0%, hsl(${hue},52%,24%) 100%)`,
                  display:'flex',alignItems:'center',justifyContent:'center',padding:14,
                }}>
                  <span style={{color:'rgba(255,255,255,.85)',fontSize:12,fontWeight:700,textAlign:'center',lineHeight:1.45,fontFamily:'var(--fd)'}}>{v.title}</span>
                </div>
            }
          </div>

          <div className="tile-overlay" style={{
            position:'absolute',inset:0,
            background:'linear-gradient(to top, rgba(8,8,15,.96) 0%, rgba(8,8,15,.6) 55%, transparent 100%)',
            display:'flex',flexDirection:'column',alignItems:'flex-start',justifyContent:'flex-end',
            padding:'10px 10px 10px',opacity:0,transition:'opacity .22s ease',
          }}>
            <span style={{color:C.t6,fontSize:12,fontWeight:700,lineHeight:1.35,marginBottom:3,fontFamily:'var(--fd)'}}>{v.title}</span>
            {authorStr && <span style={{color:C.t3,fontSize:10}}>{authorStr.length > 22 ? authorStr.slice(0,20)+'…' : authorStr}</span>}
            {book.analysis && (
              <span className="badge-pop" style={{marginTop:5,fontSize:9,color:C.em,fontFamily:'var(--fm)',background:C.em1,border:`1px solid rgba(45,212,160,.3)`,padding:'2px 7px',borderRadius:20,letterSpacing:.4}}>
                ✓ ANALYZED
              </span>
            )}
          </div>

          <button
            onClick={e=>{e.stopPropagation();onEdit(book);}}
            className="tile-btn-edit"
            style={{position:'absolute',top:7,left:7,width:26,height:26,borderRadius:'50%',background:'rgba(124,110,248,.88)',border:'none',color:'#fff',display:'flex',alignItems:'center',justifyContent:'center',opacity:0,transition:'opacity .18s ease'}}
          >
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </button>
          <button
            onClick={e=>{e.stopPropagation();onRemove(book.id);}}
            className="tile-btn-rm"
            style={{position:'absolute',top:7,right:7,width:26,height:26,borderRadius:'50%',background:'rgba(240,98,146,.88)',border:'none',color:'#fff',fontSize:16,fontWeight:700,display:'flex',alignItems:'center',justifyContent:'center',opacity:0,transition:'opacity .18s ease',lineHeight:1}}
          >
            ×
          </button>
        </div>
      );
    }

    // ── LIBRARY GRID ──────────────────────────────────────────────────────────────
    function LibraryGrid({ books, onSelect, onRemove, onEdit, onAddClick }) {
      return (
        <div style={{marginBottom:48}}>
          <div style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:20}}>
            <h2 style={{fontSize:15,fontWeight:700,fontFamily:'var(--fm)',color:C.t3,letterSpacing:.6,textTransform:'uppercase'}}>
              My Library <span style={{color:C.t2,marginLeft:6}}>{books.length}</span>
            </h2>
            <button
              onClick={onAddClick}
              className="btn-shine"
              style={{display:'flex',alignItems:'center',gap:6,padding:'8px 16px',background:C.p1,border:`1px solid ${C.borderP}`,borderRadius:10,color:C.p,fontWeight:700,fontSize:13}}
