    // ── MAIN APP ─────────────────────────────────────────────────────────────────
    function App() {
      const [apiKey, setApiKey]             = useState(() => localStorage.getItem('lib_gemini_key') || '');
      const [showSettings, setShowSettings] = useState(false);
      const [query, setQuery]               = useState('');
      const [suggestions, setSuggestions]   = useState([]);
      const [loadingSug, setLoadingSug]     = useState(false);
      const [showDrop, setShowDrop]         = useState(false);
      const [book, setBook]                 = useState(null);
      const [analysis, setAnalysis]         = useState(null);
      const [loading, setLoading]           = useState(false);
      const [error, setError]               = useState('');
      const [myBooks, setMyBooks]           = useState(() => {
        try { return JSON.parse(localStorage.getItem('lib_my_books') || '[]'); }
        catch { return []; }
      });
      const [showAddModal, setShowAddModal] = useState(false);
      const [editingBook, setEditingBook]   = useState(null);
      const wrapRef = useRef(null);

      const fetchBooks = useCallback(debounce(async (q) => {
        if (!q || q.length < 2) { setSuggestions([]); setShowDrop(false); return; }
        setLoadingSug(true);
        try {
          const url  = `https://openlibrary.org/search.json?q=${encodeURIComponent(q)}&limit=8&fields=key,title,author_name,cover_i,first_publish_year,number_of_pages_median`;
          const res  = await fetch(url);
          const data = await res.json();
          const normalized = (data.docs || []).map(doc => ({
            id: doc.key,
            volumeInfo: {
              title: doc.title,
              authors: doc.author_name || [],
              imageLinks: doc.cover_i
                ? { thumbnail:`https://covers.openlibrary.org/b/id/${doc.cover_i}-M.jpg`,
                    smallThumbnail:`https://covers.openlibrary.org/b/id/${doc.cover_i}-S.jpg` }
                : null,
              description: '',
              pageCount: doc.number_of_pages_median || null,
              publishedDate: doc.first_publish_year ? String(doc.first_publish_year) : '',
              categories: [],
            },
          }));
          setSuggestions(normalized);
          setShowDrop(normalized.length > 0);
        } catch { setSuggestions([]); setShowDrop(false); }
        setLoadingSug(false);
      }, 350), []);

      useEffect(() => { fetchBooks(query); }, [query]);
      useEffect(() => {
        const down = e => { if (wrapRef.current && !wrapRef.current.contains(e.target)) setShowDrop(false); };
        document.addEventListener('mousedown', down);
        return () => document.removeEventListener('mousedown', down);
      }, []);

      const pick          = b => { setBook(b); setQuery(b.volumeInfo.title); setShowDrop(false); setAnalysis(b.analysis||null); setError(''); };
      const reset         = () => { setBook(null); setQuery(''); setAnalysis(null); setError(''); setSuggestions([]); };
      const saveMyBooks   = updated => { setMyBooks(updated); localStorage.setItem('lib_my_books', JSON.stringify(updated)); };
      const saveToLibrary = () => { if (!book||myBooks.some(b=>b.id===book.id)) return; saveMyBooks([...myBooks,{...book,...(analysis?{analysis}:{})}]); };
      const removeBook    = bookId => { saveMyBooks(myBooks.filter(b=>b.id!==bookId)); if(book&&book.id===bookId)reset(); };

      const addBook = ({ title, author, coverUrl, year, description }) => {
        saveMyBooks([...myBooks, {
          id:'manual_'+Date.now(),
          volumeInfo:{title:title.trim(),authors:[author.trim()],imageLinks:coverUrl.trim()?{thumbnail:coverUrl.trim(),smallThumbnail:coverUrl.trim()}:null,pageCount:null,publishedDate:year.trim(),description:description.trim(),categories:[]},
        }]);
      };

      const saveEdit = updatedBook => {
        const idx = myBooks.findIndex(b=>b.id===updatedBook.id);
        if (idx===-1) return;
        const updated=[...myBooks]; updated[idx]=updatedBook;
        saveMyBooks(updated); setEditingBook(null);
        if (book&&book.id===updatedBook.id) { setBook(updatedBook); setAnalysis(updatedBook.analysis||null); }
      };

      const generate = async () => {
        if (!apiKey) { setShowSettings(true); return; }
        setLoading(true); setError(''); setAnalysis(null);
        try {
          const v = book.volumeInfo;
          const result = await callAI(apiKey, v.title, (v.authors||['Unknown']).join(', '), v.description);
          setAnalysis(result);
          const idx = myBooks.findIndex(b=>b.id===book.id);
          if (idx!==-1) { const u=[...myBooks]; u[idx]={...u[idx],analysis:result}; saveMyBooks(u); }
        } catch(e) { setError(e.message); }
        setLoading(false);
      };

      const inLibrary = book && myBooks.some(b=>b.id===book.id);

      return (
        <div style={{minHeight:'100vh',paddingBottom:80}}>

          {/* ── HEADER ── */}
          <div style={{
            display:'flex',alignItems:'center',justifyContent:'space-between',
            padding:'18px 32px',
            borderBottom:`1px solid ${C.border}`,
            position:'sticky',top:0,zIndex:100,
            background:'rgba(8,8,15,.88)',
            backdropFilter:'blur(16px)',
          }}>
            <button onClick={reset} style={{display:'flex',alignItems:'center',gap:14,background:'transparent',border:'none',padding:0,cursor:'pointer'}}>
              <div style={{
                width:36,height:36,
                background:`linear-gradient(135deg,${C.p1},${C.p2})`,
                border:`1px solid ${C.borderP}`,
                borderRadius:10,display:'flex',alignItems:'center',justifyContent:'center',
                color:C.p,animation:'glowPulse 4s ease-in-out infinite',
              }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
              </div>
              <span style={{fontSize:18,fontWeight:800,fontFamily:'var(--fd)',color:C.t6,letterSpacing:.5}}>Library</span>
              {myBooks.length > 0 && (
                <span style={{fontSize:11,fontFamily:'var(--fm)',color:C.t2,background:C.surface2,border:`1px solid ${C.border}`,padding:'2px 8px',borderRadius:20}}>
                  {myBooks.length}
                </span>
              )}
            </button>

            <button
              onClick={()=>setShowSettings(true)}
              title="API Settings"
              style={{
                background:`linear-gradient(135deg,rgba(124,110,248,.15),rgba(124,110,248,.07))`,
                border:`1px solid rgba(124,110,248,.3)`,
                borderRadius:10,width:40,height:40,
                display:'flex',alignItems:'center',justifyContent:'center',
                color:'#a78bfa',
                boxShadow:'0 0 14px rgba(124,110,248,.2)',
                transition:'transform .25s cubic-bezier(.22,1,.36,1),box-shadow .25s ease',
              }}
              onMouseEnter={e=>{e.currentTarget.style.transform='rotate(60deg) scale(1.1)';e.currentTarget.style.boxShadow='0 0 22px rgba(124,110,248,.4)';}}
              onMouseLeave={e=>{e.currentTarget.style.transform='none';e.currentTarget.style.boxShadow='0 0 14px rgba(124,110,248,.2)';}}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
            </button>
          </div>

          <div style={{maxWidth:780,margin:'0 auto',padding:'44px 24px 0'}}>

            {/* ── API KEY BANNER ── */}
            {!apiKey && (
              <div className="au" style={{marginBottom:28,padding:'14px 20px',background:'rgba(124,110,248,.07)',border:`1px solid rgba(124,110,248,.25)`,borderRadius:12,display:'flex',alignItems:'center',justifyContent:'space-between',gap:16}}>
                <div style={{display:'flex',alignItems:'center',gap:10}}>
                  <span style={{fontSize:16}}>✦</span>
                  <span style={{fontSize:13,color:C.t3}}>Add your free Gemini API key to enable AI book analysis.</span>
                </div>
                <button onClick={()=>setShowSettings(true)} className="btn-shine" style={{background:C.p,border:'none',borderRadius:8,color:'#fff',fontWeight:700,fontSize:12,padding:'8px 16px',flexShrink:0,letterSpacing:.3}}>
                  Add Key
                </button>
              </div>
            )}

            {/* ── SEARCH ── */}
            <div ref={wrapRef} style={{position:'relative',marginBottom:36}} className="au">
              <div
                style={{display:'flex',alignItems:'center',background:C.surface,border:`1px solid ${C.border}`,borderRadius:14,gap:4,transition:'border-color .2s ease,box-shadow .2s ease'}}
                onFocusCapture={e=>{e.currentTarget.style.borderColor=C.borderP;e.currentTarget.style.boxShadow='0 0 0 3px rgba(124,110,248,.1)';}}
                onBlurCapture={e=>{e.currentTarget.style.borderColor=C.border;e.currentTarget.style.boxShadow='none';}}
              >
                <span style={{padding:'0 14px 0 18px',color:C.t2,display:'flex',alignItems:'center'}}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                </span>
                <input
                  value={query}
                  onChange={e=>{setQuery(e.target.value);if(book)setBook(null);setAnalysis(null);}}
                  onFocus={()=>suggestions.length>0&&setShowDrop(true)}
                  placeholder="Search any book by title or author…"
                  style={{flex:1,background:'transparent',border:'none',outline:'none',padding:'16px 0',fontSize:16,color:C.t6,boxShadow:'none'}}
                />
                <div style={{padding:'0 16px',display:'flex',alignItems:'center',gap:8}}>
                  {loadingSug && <div style={{width:16,height:16,border:`2px solid ${C.border}`,borderTop:`2px solid ${C.p}`,borderRadius:'50%',animation:'spin .7s linear infinite'}} />}
                  {(query||book) && <button onClick={reset} style={{background:'transparent',border:'none',color:C.t2,fontSize:20,lineHeight:1,padding:0}}>&times;</button>}
                </div>
              </div>

              {showDrop && suggestions.length > 0 && (
                <div style={{position:'absolute',top:'calc(100% + 6px)',left:0,right:0,background:C.surface,border:`1px solid ${C.border}`,borderRadius:14,overflow:'hidden',zIndex:50,boxShadow:'0 20px 56px rgba(0,0,0,.7)',animation:'fadeIn .18s ease both'}}>
                  {suggestions.map((s, idx) => {
                    const v   = s.volumeInfo;
                    const img = v.imageLinks?.smallThumbnail?.replace('http:','https:');
                    return (
                      <div key={s.id} className="suggestion-item"
                        onClick={()=>pick(s)}
                        style={{display:'flex',alignItems:'center',gap:14,padding:'11px 16px',cursor:'pointer',borderBottom:idx<suggestions.length-1?`1px solid ${C.border}`:'none',transition:'background .1s ease'}}
                      >
                        {img
                          ? <img src={img} style={{width:30,height:44,objectFit:'cover',borderRadius:4,flexShrink:0}} />
                          : <div style={{width:30,height:44,background:C.surface2,borderRadius:4,flexShrink:0,border:`1px solid ${C.border}`}} />
                        }
                        <div style={{minWidth:0}}>
                          <div style={{fontWeight:700,fontSize:13,color:C.t6,whiteSpace:'nowrap',overflow:'hidden',textOverflow:'ellipsis',fontFamily:'var(--fd)'}}>{v.title}</div>
                          <div style={{fontSize:11,color:C.t2,marginTop:3,fontFamily:'var(--fm)'}}>{(v.authors||[]).join(', ')}{v.publishedDate?` · ${v.publishedDate.slice(0,4)}`:''}</div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            {/* ── MY LIBRARY GRID ── */}
            {!book && !loading && (
              <LibraryGrid books={myBooks} onSelect={pick} onRemove={removeBook} onEdit={b=>setEditingBook(b)} onAddClick={()=>setShowAddModal(true)} />
            )}

            {/* ── SELECTED BOOK ── */}
            {book && !analysis && !loading && (
              <div className="au">
                <BookCard book={book} />
                <button
                  onClick={generate}
                  className="btn-shine btn-lift"
                  style={{width:'100%',marginTop:12,padding:'17px',background:`linear-gradient(135deg,${C.p},#9b8dfa)`,border:'none',borderRadius:14,color:'#fff',fontWeight:800,fontSize:15,letterSpacing:.4,fontFamily:'var(--fd)',boxShadow:`0 4px 24px rgba(124,110,248,.3)`}}
                >
                  ✦ Generate AI Analysis
                </button>
                {inLibrary
                  ? <p style={{textAlign:'center',marginTop:10,fontSize:12,color:C.em,fontWeight:700,fontFamily:'var(--fm)',letterSpacing:.4}}>✓ IN LIBRARY</p>
                  : <button onClick={saveToLibrary} className="btn-shine" style={{width:'100%',marginTop:8,padding:'13px',background:'transparent',border:`1px solid ${C.border}`,borderRadius:14,color:C.t3,fontWeight:600,fontSize:14}}>+ Save to Library</button>
                }
              </div>
            )}

            {/* ── LOADING ── */}
            {loading && (
              <div className="au" style={{textAlign:'center',padding:'70px 0',color:C.t2}}>
                <div style={{display:'flex',justifyContent:'center',marginBottom:24}}>
                  <div style={{position:'relative',width:52,height:52,display:'flex',alignItems:'center',justifyContent:'center'}}>
                    <div style={{position:'absolute',inset:0,border:`2px solid ${C.border}`,borderTop:`2px solid ${C.p}`,borderRadius:'50%',animation:'spin .9s linear infinite'}} />
                    <div style={{position:'absolute',inset:8,border:`1px solid ${C.border}`,borderTop:`1px solid ${C.em}`,borderRadius:'50%',animation:'spin 1.4s linear infinite reverse'}} />
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={C.p} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                    </svg>
                  </div>
                </div>
                <p style={{fontSize:15,color:C.t4,fontFamily:'var(--fd)'}}>Analyzing <strong style={{color:C.p}}>{book?.volumeInfo.title}</strong></p>
                <p style={{fontSize:12,marginTop:6,color:C.t2,fontFamily:'var(--fm)',letterSpacing:.3}}>GEMINI 2.5 FLASH · WORKING…</p>
              </div>
            )}

            {/* ── ERROR ── */}
            {error && (
              <div className="au" style={{marginTop:16,padding:'16px 20px',background:'rgba(240,98,146,.07)',border:`1px solid rgba(240,98,146,.28)`,borderLeft:`3px solid ${C.error}`,borderRadius:12,color:C.error,fontSize:13}}>
                <strong>Error:</strong> {error}
              </div>
            )}

            {/* ── ANALYSIS ── */}
            {analysis && book && (
              <div className="au">
                <BookCard book={book} />
                <div style={{marginTop:14}}>
                  {analysis.summary           && <SummarySection text={analysis.summary} />}
                  {analysis.goldenTips?.length > 0 && <TipsSection tips={analysis.goldenTips} />}
                  {analysis.realLife?.length   > 0 && <RealLifeSection points={analysis.realLife} />}
                  {analysis.chapters?.length   > 0 && <ChaptersSection chapters={analysis.chapters} />}
                </div>
                <div style={{display:'flex',gap:10,marginTop:10}}>
                  <button onClick={()=>setAnalysis(null)} style={{flex:1,padding:'13px',background:'transparent',border:`1px solid ${C.border}`,borderRadius:14,color:C.t3,fontWeight:600,fontSize:13}}>
                    Regenerate
                  </button>
                  {inLibrary
                    ? <div style={{flex:1,padding:'13px',borderRadius:14,border:`1px solid rgba(45,212,160,.3)`,color:C.em,fontWeight:700,fontSize:13,textAlign:'center',fontFamily:'var(--fm)',letterSpacing:.4}}>✓ IN LIBRARY</div>
                    : <button onClick={saveToLibrary} className="btn-shine" style={{flex:1,padding:'13px',background:C.p1,border:`1px solid ${C.borderP}`,borderRadius:14,color:C.p,fontWeight:700,fontSize:13}}>+ Save to Library</button>
                  }
                </div>
              </div>
            )}

            {/* ── EMPTY STATE ── */}
            {myBooks.length===0 && !book && !loading && !query && (
              <div className="au" style={{textAlign:'center',padding:'80px 0',color:C.t2}}>
                <svg className="float" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="rgba(124,110,248,.3)" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" style={{marginBottom:20}}>
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
                <p style={{fontSize:18,fontWeight:800,color:C.t5,marginBottom:8,fontFamily:'var(--fd)'}}>Find your next book</p>
                <p style={{fontSize:13,lineHeight:1.7,maxWidth:340,margin:'0 auto'}}>Search any book and get a full AI analysis — summary, golden tips, real-life takeaways, and chapter breakdowns.</p>
              </div>
            )}
          </div>

          {showSettings && <SettingsModal apiKey={apiKey} onSave={key=>{setApiKey(key);localStorage.setItem('lib_gemini_key',key);}} onClose={()=>setShowSettings(false)} />}
          {showAddModal && <AddBookModal onSave={data=>{addBook(data);setShowAddModal(false);}} onClose={()=>setShowAddModal(false)} />}
          {editingBook  && <EditBookModal book={editingBook} onSave={saveEdit} onClose={()=>setEditingBook(null)} />}
        </div>
      );
    }

    // Tile hover via CSS injection
    const s = document.createElement('style');
    s.textContent = `.card-tilt:hover .tile-overlay{opacity:1!important}.card-tilt:hover .tile-btn-edit{opacity:1!important}.card-tilt:hover .tile-btn-rm{opacity:1!important}`;
    document.head.appendChild(s);

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
